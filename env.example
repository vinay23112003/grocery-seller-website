# MongoDB Connection (Get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://yourusername:yourpassword@cluster0.xxxxx.mongodb.net/grocerydb?retryWrites=true&w=majority

# Twilio for WhatsApp/SMS (Optional - Sign up at twilio.com)
TWILIO_SID=your_twilio_account_sid_here
TWILIO_TOKEN=your_twilio_auth_token_here

# App Settings
BASE_URL=http://localhost:5000
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
NODE_ENV=development
